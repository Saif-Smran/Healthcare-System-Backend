<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to PH Healthcare System</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; -webkit-font-smoothing: antialiased;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f4f6f9; padding: 40px 0;">
        <tr>
            <td align="center">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 560px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0;">
                    
                    <!-- Header -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #059669 0%, #047857 100%); padding: 32px 40px; text-align: center;">
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td align="center">
                                        <div style="display: inline-block; background-color: rgba(255, 255, 255, 0.2); width: 56px; height: 56px; border-radius: 50%; line-height: 56px; font-size: 28px; color: #ffffff; margin-bottom: 12px;">
                                            🏥
                                        </div>
                                        <h1 style="color: #ffffff; margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.5px;">PH Healthcare System</h1>
                                        <p style="color: #d1fae5; margin: 4px 0 0 0; font-size: 13px;">Welcome to Your Healthcare Portal</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Body Content -->
                    <tr>
                        <td style="padding: 40px;">
                            <h2 style="color: #0f172a; font-size: 18px; margin: 0 0 16px 0; font-weight: 600;">Welcome, <%= typeof name !== 'undefined' && name ? name : 'Patient' %>! 🎉</h2>
                            <p style="color: #475569; font-size: 14px; line-height: 1.6; margin: 0 0 24px 0;">
                                We are thrilled to welcome you to the PH Healthcare System. Your patient account has been successfully created and verified.
                            </p>

                            <!-- Features Card -->
                            <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; margin-bottom: 24px;">
                                <h3 style="color: #0f172a; font-size: 15px; margin: 0 0 12px 0; font-weight: 600;">Here is what you can do with your account:</h3>
                                <ul style="margin: 0; padding-left: 20px; color: #475569; font-size: 14px; line-height: 1.8;">
                                    <li>Book appointments with certified healthcare specialists</li>
                                    <li>View and manage your medical history & prescriptions</li>
                                    <li>Receive real-time updates and appointment notifications</li>
                                </ul>
                            </div>

                            <p style="color: #475569; font-size: 14px; line-height: 1.6; margin: 0 0 24px 0;">
                                You can now sign in to your account and start exploring our health services.
                            </p>

                            <!-- Success Banner -->
                            <div style="background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 10px; padding: 16px 20px; text-align: center; margin-bottom: 24px;">
                                <p style="color: #065f46; font-size: 14px; font-weight: 600; margin: 0;">
                                    💚 Thank you for choosing PH Healthcare System.
                                </p>
                            </div>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="background-color: #f8fafc; padding: 24px 40px; text-align: center; border-top: 1px solid #e2e8f0;">
                            <p style="color: #94a3b8; font-size: 12px; margin: 0 0 6px 0;">
                                &copy; <%= typeof year !== 'undefined' ? year : new Date().getFullYear() %> PH Healthcare System. All rights reserved.
                            </p>
                            <p style="color: #cbd5e1; font-size: 11px; margin: 0;">
                                This is an automated welcome email. Please do not reply directly to this message.
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
